{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "npm test": "allow",
      "npm run*": "allow",
      "node --test*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "pwd": "allow",
      "wc*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "mkdir -p .bugfix/*": "allow",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "git push*": "deny",
      "git commit*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git apply*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git clone*": "deny",
      "git fetch*": "deny",
      "rm -rf *": "deny",
      "rm *": "deny",
      "mv *": "deny",
      "sed -i*": "deny",
      "npm publish*": "deny",
      "npx*": "deny",
      "sudo*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "kill*": "deny",
      "docker*": "deny",
      "kubectl*": "deny",
      "helm*": "deny",
      "terraform*": "deny"
    }
  }
}